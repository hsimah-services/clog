# Copy to .env and adjust. `.env` is gitignored; this template is not.
# Everything here is local-only development credentials — never reuse in production.

# --- MySQL (consumed by the `db` service) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# --- WordPress database connection ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1

# --- Redis object cache ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- WPGraphQL JWT ---
GRAPHQL_JWT_AUTH_SECRET_KEY=clog-local-dev-jwt-secret-change-me

# --- Automatic `wp core install` performed by .docker/wordpress/entrypoint.sh ---
WP_URL=http://localhost:8080
WP_TITLE=Clog
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# --- Client (Vite) ---
VITE_GRAPHQL_URL=http://localhost:8080/graphql
