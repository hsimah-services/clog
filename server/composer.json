{
    "name": "hsimah/clog",
    "description": "Clog (Cave Log) — WordPress plugin: inventory post types exposed via WPGraphQL.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hsimah/elephentity"
        }
    ],
    "require": {
        "php": ">=8.3",
        "elephentity/elephentity": "0.0.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.31"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Clog\\Entity\\": "generated/",
            "Clog\\Type\\": "src/Type/",
            "Clog\\": "src/"
        }
    }
}
