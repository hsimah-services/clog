{
    "name": "hsimah/clog",
    "description": "Clog (Cave Log) — WordPress plugin: inventory post types exposed via WPGraphQL.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../elephentity",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../elephentity-codegen",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../elephentity-codegen-php",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "elephentity/elephentity": "*"
    },
    "require-dev": {
        "elephentity/codegen": "*",
        "elephentity/codegen-php": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.31"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Clog\\Entity\\": "generated/",
            "Clog\\Type\\": "src/Type/",
            "Clog\\": "src/"
        }
    }
}
